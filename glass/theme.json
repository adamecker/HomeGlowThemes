{
  "manifestVersion": 8,
  "id": "glass",
  "version": "1.1.0",
  "author": "mrramam",
  "name": "Glass",
  "description": "Frosted glass cards with a bright rim of light over soft ribbons of color, in the spirit of today's desktop look. Light and dark. Card opacity runs from clear to tinted.",
  "extends": "classic",
  "modes": ["light", "dark"],
  "variety": "load",
  "colors": { "primary": "#f2f2f7", "secondary": "#5856d6", "accent": "#007aff" },
  "tokens": {
    "all": {
      "--hg-font-body": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, system-ui, sans-serif",
      "--hg-font-heading": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, system-ui, sans-serif",
      "--hg-radius-sm": "10px",
      "--hg-radius-md": "16px",
      "--hg-radius-lg": "22px",
      "--hg-radius-xl": "28px",
      "--hg-radius-2xl": "999px",
      "--hg-frame-radius": "28px",
      "--hg-frame-decoration-width": "1px",
      "--hg-frame-decoration-style": "solid",
      "--hg-frame-inset": "2px",
      "--hg-grid-gap": "16px",
      "--success": "#34c759",
      "--warning": "#ff9500",
      "--hg-meter-thickness": "6px",
      "--hg-meter-cap": "round",
      "--hg-meter-fill": "var(--accent)",
      "--hg-button-radius": "999px",
      "--hg-button-weight": "600",
      "--hg-button-text": "#ffffff"
    },
    "light": {
      "--primary": "#f2f2f7",
      "--secondary": "#5856d6",
      "--accent": "#007aff",
      "--accent-rgb": "0, 122, 255",
      "--background": "#d6e4ff",
      "--surface": "#f2f2f7",
      "--card-bg": "rgba(255, 255, 255, 0.54)",
      "--hg-frame-bg": "rgba(255, 255, 255, 0.54)",
      "--hg-frame-backdrop": "blur(16px) saturate(180%)",
      "--text": "#1d1d1f",
      "--text-secondary": "#4a4a52",
      "--border": "rgba(60, 60, 67, 0.18)",
      "--card-border": "rgba(60, 60, 67, 0.18)",
      "--hg-hover": "rgba(0, 122, 255, 0.1)",
      "--hg-on-overlay": "#1d1d1f",
      "--hg-error": "#ff3b30",
      "--hg-error-hover": "#d70015",
      "--hg-error-surface": "rgba(255, 59, 48, 0.12)",
      "--hg-frame-decoration-color": "rgba(255, 255, 255, 0.95) rgba(255, 255, 255, 0.55) rgba(255, 255, 255, 0.3) rgba(255, 255, 255, 0.8)",
      "--hg-frame-shadow": "inset 0 1px 0 rgba(255, 255, 255, 0.9), inset 0 -1px 0 rgba(255, 255, 255, 0.35), 0 10px 30px rgba(20, 40, 90, 0.16), 0 1px 3px rgba(20, 40, 90, 0.1)",
      "--hg-frame-shadow-hover": "inset 0 1px 0 rgba(255, 255, 255, 0.95), inset 0 -1px 0 rgba(255, 255, 255, 0.4), 0 14px 40px rgba(20, 40, 90, 0.22), 0 1px 3px rgba(20, 40, 90, 0.12)",
      "--hg-frame-image": "linear-gradient(180deg, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0.06) 45%, rgba(255, 255, 255, 0.14) 100%)",
      "--hg-frame-overlay": "linear-gradient(125deg, rgba(255, 255, 255, 0.32) 0%, rgba(255, 255, 255, 0) 18%, rgba(255, 255, 255, 0) 82%, rgba(255, 255, 255, 0.18) 100%)",
      "--shadow": "0 8px 24px rgba(20, 40, 90, 0.14)",
      "--bottom-bar-bg": "rgba(255, 255, 255, 0.55)",
      "--dock-bg": "rgba(255, 255, 255, 0.55)",
      "--dock-border": "rgba(255, 255, 255, 0.9)",
      "--dock-separator": "rgba(60, 60, 67, 0.2)",
      "--dock-icon": "#1d1d1f",
      "--dock-active-bg": "rgba(255, 255, 255, 0.85)",
      "--dock-active-border": "rgba(255, 255, 255, 1)",
      "--dock-active-icon": "#007aff",
      "--light-gradient-start": "#e8efff",
      "--light-gradient-end": "#c9dbff",
      "--light-button-gradient-start": "#2b8cff",
      "--light-button-gradient-end": "#007aff",
      "--hg-meter-track": "rgba(60, 60, 67, 0.14)",
      "--hg-button-bg": "#007aff",
      "--hg-button-quiet-border": "rgba(60, 60, 67, 0.3)"
    },
    "dark": {
      "--primary": "#1c1c1e",
      "--secondary": "#5e5ce6",
      "--accent": "#0a84ff",
      "--accent-rgb": "10, 132, 255",
      "--background": "#060b18",
      "--surface": "#1c1c1e",
      "--card-bg": "rgba(53, 53, 53, 0.5)",
      "--hg-frame-bg": "rgba(53, 53, 53, 0.5)",
      "--hg-frame-backdrop": "blur(16px) saturate(240%)",
      "--text": "#f5f5f7",
      "--text-secondary": "#aeaeb2",
      "--border": "rgba(235, 235, 245, 0.16)",
      "--card-border": "rgba(235, 235, 245, 0.16)",
      "--hg-hover": "rgba(10, 132, 255, 0.16)",
      "--hg-on-overlay": "#f5f5f7",
      "--hg-error": "#ff453a",
      "--hg-error-hover": "#ff6961",
      "--hg-error-surface": "rgba(255, 69, 58, 0.18)",
      "--hg-frame-decoration-color": "rgba(255, 255, 255, 0.42) rgba(255, 255, 255, 0.18) rgba(255, 255, 255, 0.08) rgba(255, 255, 255, 0.3)",
      "--hg-frame-shadow": "inset 0 1px 0 rgba(255, 255, 255, 0.28), inset 0 -1px 0 rgba(255, 255, 255, 0.08), 0 12px 34px rgba(0, 0, 0, 0.45), 0 1px 3px rgba(0, 0, 0, 0.3)",
      "--hg-frame-shadow-hover": "inset 0 1px 0 rgba(255, 255, 255, 0.36), inset 0 -1px 0 rgba(255, 255, 255, 0.1), 0 16px 44px rgba(0, 0, 0, 0.55), 0 1px 3px rgba(0, 0, 0, 0.3)",
      "--hg-frame-image": "linear-gradient(180deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.02) 45%, rgba(255, 255, 255, 0.05) 100%)",
      "--hg-frame-overlay": "linear-gradient(125deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 18%, rgba(255, 255, 255, 0) 82%, rgba(255, 255, 255, 0.08) 100%)",
      "--shadow": "0 8px 28px rgba(0, 0, 0, 0.4)",
      "--bottom-bar-bg": "rgba(40, 40, 46, 0.6)",
      "--dock-bg": "rgba(40, 40, 46, 0.6)",
      "--dock-border": "rgba(255, 255, 255, 0.22)",
      "--dock-separator": "rgba(235, 235, 245, 0.18)",
      "--dock-icon": "#f5f5f7",
      "--dock-active-bg": "rgba(255, 255, 255, 0.2)",
      "--dock-active-border": "rgba(255, 255, 255, 0.4)",
      "--dock-active-icon": "#0a84ff",
      "--dark-gradient-start": "#0a1226",
      "--dark-gradient-end": "#060b18",
      "--dark-button-gradient-start": "#3395ff",
      "--dark-button-gradient-end": "#0a84ff",
      "--hg-meter-track": "rgba(235, 235, 245, 0.16)",
      "--hg-button-bg": "#0a84ff",
      "--hg-button-quiet-border": "rgba(235, 235, 245, 0.3)"
    }
  },
  "mui": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, system-ui, sans-serif",
    "radius": 14,
    "pillButtons": true
  },
  "muiModes": {
    "light": { "mode": "light", "primary": "#007aff", "secondary": "#5856d6", "error": "#ff3b30", "background": "#f2f2f7", "paper": "#ffffff", "text": "#1d1d1f", "textSecondary": "#6e6e73", "divider": "#d1d1d6" },
    "dark": { "mode": "dark", "primary": "#0a84ff", "secondary": "#5e5ce6", "error": "#ff453a", "background": "#000000", "paper": "#1c1c1e", "text": "#f5f5f7", "textSecondary": "#aeaeb2", "divider": "#38383a" }
  },
  "ambience": [
    {
      "layer": "image",
      "modes": ["light"],
      "anchor": "fill",
      "src": ["assets/wall-tide-light.svg", "assets/wall-dusk-light.svg", "assets/wall-lagoon-light.svg"]
    },
    {
      "layer": "image",
      "modes": ["dark"],
      "anchor": "fill",
      "src": ["assets/wall-tide-dark.svg", "assets/wall-dusk-dark.svg", "assets/wall-lagoon-dark.svg"]
    }
  ],
  "confetti": {
    "colors": ["#ff3b30", "#ff9500", "#ffcc00", "#34c759", "#5ac8fa", "#007aff", "#5856d6", "#ff2d55"],
    "shapes": ["circle", "streamer"],
    "pictures": [{ "src": "assets/glass-bead.svg", "aspect": 1, "height": [14, 26], "weight": 3 }],
    "mix": 0.3
  }
}
